{
  "name": "shadcn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm build:registry && next build",
    "build:registry": "tsx scripts/build-registry.ts",
    "start": "next start",
    "check": "biome check",
    "check:staged": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "check:write": "biome check --write",
    "ci:check": "biome ci",
    "registry:check": "pnpm run build:registry && git diff --exit-code -- public/registry",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
